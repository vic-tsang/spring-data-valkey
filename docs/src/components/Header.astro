---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const navItems = [
	{ label: 'Overview', href: '/overview/', match: (p: string) => p.startsWith('/overview') },
	{ label: 'Features', href: '/commons/features/', match: (p: string) => p.startsWith('/commons/features') },
	{
		label: 'Getting Started',
		href: '/valkey/getting-started/',
		match: (p: string) => p.startsWith('/valkey/getting-started'),
	},
	{
		label: 'Valkey',
		href: '/valkey/',
		match: (p: string) => p.startsWith('/valkey') && !p.startsWith('/valkey/getting-started'),
	},
	{ label: 'Repositories', href: '/repositories/', match: (p: string) => p.startsWith('/repositories') },
	{ label: 'Migration', href: '/commons/migration/', match: (p: string) => p.startsWith('/commons/migration') },
];

const currentPath = Astro.url.pathname;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="middle sl-flex print:hidden">
		<nav class="top-nav sl-hidden md:sl-flex" aria-label="Main">
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a href={item.href} aria-current={item.match(currentPath) ? 'true' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="search sl-flex">
			{shouldRenderSearch && <Search />}
		</div>
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.middle {
			align-items: center;
			gap: 1rem;
			min-width: 0;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		.top-nav ul {
			display: flex;
			gap: 0.25rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.top-nav a {
			display: flex;
			align-items: center;
			padding: 0.5rem 0.65rem;
			border-radius: 0.375rem;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			text-decoration: none;
			white-space: nowrap;
		}
		.top-nav a:hover {
			color: var(--sl-color-white);
		}
		.top-nav a[aria-current='true'] {
			color: var(--sl-color-text-accent);
		}

		/* Tablet: make room for the nav by using an icon-only search, smaller links and tighter gaps. */
		@media (min-width: 50rem) and (max-width: 71.99rem) {
			.top-nav ul {
				gap: 0;
			}
			.top-nav a {
				padding: 0.5rem 0.4rem;
				font-size: var(--sl-text-xs);
			}
			.header,
			.right-group,
			.middle {
				gap: 0.5rem;
			}
		}

		/* Narrow tablet: icon-only search. */
		@media (min-width: 50rem) and (max-width: 63.99rem) {
			.search :global(site-search button) {
				width: 2.5rem !important;
				min-width: 0 !important;
				padding: 0 !important;
				justify-content: center;
			}
			.search :global(site-search button span),
			.search :global(site-search button kbd) {
				display: none !important;
			}
		}

		/* Wider tablet and up: search box with the "Search" label. */
		@media (min-width: 64rem) {
			.search {
				min-width: 0;
			}
			.search :global(site-search) {
				flex: 1;
				display: flex;
				justify-content: flex-end;
			}
			.search :global(site-search button) {
				max-width: 14rem;
			}
		}

		@media (min-width: 72rem) {
			.search :global(site-search button) {
				max-width: 32rem;
			}
		}

		@media (min-width: 50rem) {
			.header {
				display: grid;
				grid-template-columns: auto 1fr auto;
				align-content: center;
			}
			.search {
				flex: 1;
				justify-content: flex-end;
			}
		}
	}
</style>
